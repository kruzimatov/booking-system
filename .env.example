# Database used by docker compose. Change the password on any shared server.
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking
POSTGRES_DB=booking

# API
DATABASE_URL=postgresql+psycopg://booking:booking@localhost:5433/booking
TEST_DATABASE_URL=postgresql+psycopg://booking:booking@localhost:5433/booking_test
# Required, at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_TTL_MINUTES=60
# true in production (HTTPS only)
COOKIE_SECURE=false

# Demo data (scripts/seed.py). Required when COOKIE_SECURE=true, so a public
# deployment never runs with the published local demo passwords.
SEED_ADMIN_PASSWORD=
SEED_CLIENT_PASSWORD=

# Email notifications via Resend (optional, disabled when blank)
RESEND_API_KEY=
